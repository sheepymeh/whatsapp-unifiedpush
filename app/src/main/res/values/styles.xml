<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FullWidth">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorButtonNormal">@color/button</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:windowBackground">@color/base</item>
        <item name="android:statusBarColor">@color/base</item>
        <item name="android:navigationBarColor">@color/base</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
