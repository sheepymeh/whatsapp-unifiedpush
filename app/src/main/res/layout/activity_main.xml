<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        style="@style/FullWidth"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/FullWidth"
            android:text="WhatsApp UnifiedPush"
            android:paddingTop="16dp"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            style="@style/FullWidth"
            android:layout_marginTop="8dp"
            android:text="Wakes WhatsApp when a push arrives."
            android:textColor="@color/muted" />

        <TextView
            android:id="@+id/status"
            style="@style/FullWidth"
            android:layout_marginTop="28dp"
            android:text="Waiting for registration"
            android:textColor="@color/accent" />

        <TextView
            android:id="@+id/sync"
            style="@style/FullWidth"
            android:layout_marginTop="8dp"
            android:textColor="@color/accent" />

        <TextView
            style="@style/FullWidth"
            android:layout_marginTop="24dp"
            android:text="Server"
            android:textColor="@color/text"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/server_url"
            style="@style/FullWidth"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_endpoint"
            android:hint="https://example.com/subscription"
            android:inputType="textUri"
            android:padding="16dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/server_token"
            style="@style/FullWidth"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_endpoint"
            android:hint="Token"
            android:inputType="textPassword"
            android:padding="16dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/save"
            style="@style/FullWidth"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_primary"
            android:stateListAnimator="@null"
            android:text="Save"
            android:textAllCaps="false"
            android:textColor="@color/base" />

        <Button
            android:id="@+id/register"
            style="@style/FullWidth"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button"
            android:stateListAnimator="@null"
            android:text="Re-register"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
