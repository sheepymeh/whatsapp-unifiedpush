<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        style="@style/FullWidth"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/FullWidth"
            android:text="WhatsApp UnifiedPush"
            android:paddingTop="8dp"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            style="@style/FullWidth"
            android:layout_marginTop="8dp"
            android:text="Wakes WhatsApp when a push arrives."
            android:textColor="@color/muted" />

        <TextView
            android:id="@+id/status"
            style="@style/FullWidth"
            android:layout_marginTop="28dp"
            android:text="Waiting for registration"
            android:textColor="@color/accent" />

        <TextView
            style="@style/FullWidth"
            android:layout_marginTop="24dp"
            android:text="UnifiedPush endpoint"
            android:textColor="@color/text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/endpoint"
            style="@style/FullWidth"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_endpoint"
            android:minHeight="64dp"
            android:padding="16dp"
            android:text="Waiting for a UnifiedPush endpoint..."
            android:textColor="@color/text"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/copy"
            style="@style/FullWidth"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/accent"
            android:text="Copy endpoint"
            android:textAllCaps="false"
            android:textColor="@color/base" />

        <Button
            android:id="@+id/register"
            style="@style/FullWidth"
            android:layout_marginTop="8dp"
            android:text="Re-register"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
